double XGBoost_Predict_WFO_USDJPY(const double &features[], int year, double &out_threshold) {
    if(year < 2016) year = 2016;
    if(year > 2026) year = 2026;

    switch(year) {
        case 2016:
            out_threshold = 0.58371;
            return Predict_WFO_USDJPY_2016(features);
        case 2017:
            out_threshold = 0.55193;
            return Predict_WFO_USDJPY_2017(features);
        case 2018:
            out_threshold = 0.56894;
            return Predict_WFO_USDJPY_2018(features);
        case 2019:
            out_threshold = 0.57866;
            return Predict_WFO_USDJPY_2019(features);
        case 2020:
            out_threshold = 0.55082;
            return Predict_WFO_USDJPY_2020(features);
        case 2021:
            out_threshold = 0.54979;
            return Predict_WFO_USDJPY_2021(features);
        case 2022:
            out_threshold = 0.56999;
            return Predict_WFO_USDJPY_2022(features);
        case 2023:
            out_threshold = 0.59640;
            return Predict_WFO_USDJPY_2023(features);
        case 2024:
            out_threshold = 0.55019;
            return Predict_WFO_USDJPY_2024(features);
        case 2025:
            out_threshold = 0.56534;
            return Predict_WFO_USDJPY_2025(features);
        case 2026:
            out_threshold = 0.55989;
            return Predict_WFO_USDJPY_2026(features);
        default:
            out_threshold = 0.55989;
            return Predict_WFO_USDJPY_2026(features);
    }
}
