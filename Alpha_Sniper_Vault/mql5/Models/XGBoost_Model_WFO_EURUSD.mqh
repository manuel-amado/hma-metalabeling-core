        if(f[5] < -1.40988541) {
            if(f[24] < 1.02194798) {
                sum += 0.0274909381;
            } else {
                sum += -0.0574204922;
            }
        } else {
            if(f[11] < -0.732130229) {
                sum += 0.00505350949;
            } else {
                sum += -0.0610643588;
            }
        }
    } else {
        if(f[1] < -0.232105047) {
            if(f[1] < -0.265792549) {
                sum += 0.00610619178;
            } else {
                sum += 0.0490611047;
            }
        } else {
            if(f[1] < -0.211381808) {
                sum += -0.0545551591;
            } else {
                sum += -0.00236280914;
            }
        }
    }
    return 1.0 / (1.0 + MathExp(-sum));
}

double XGBoost_Predict_WFO_EURUSD(const double &features[], int year, double &out_threshold) {
    if(year < 2016) year = 2016;
    if(year > 2026) year = 2026;

    switch(year) {
        case 2016:
            out_threshold = 0.59248;
            return Predict_WFO_EURUSD_2016(features);
        case 2017:
            out_threshold = 0.54878;
            return Predict_WFO_EURUSD_2017(features);
        case 2018:
            out_threshold = 0.55428;
            return Predict_WFO_EURUSD_2018(features);
        case 2019:
            out_threshold = 0.55625;
            return Predict_WFO_EURUSD_2019(features);
        case 2020:
            out_threshold = 0.56726;
            return Predict_WFO_EURUSD_2020(features);
        case 2021:
            out_threshold = 0.58184;
            return Predict_WFO_EURUSD_2021(features);
        case 2022:
            out_threshold = 0.62822;
            return Predict_WFO_EURUSD_2022(features);
        case 2023:
            out_threshold = 0.59527;
            return Predict_WFO_EURUSD_2023(features);
        case 2024:
            out_threshold = 0.57525;
            return Predict_WFO_EURUSD_2024(features);
        case 2025:
            out_threshold = 0.56224;
            return Predict_WFO_EURUSD_2025(features);
        case 2026:
            out_threshold = 0.54480;
            return Predict_WFO_EURUSD_2026(features);
        default:
            out_threshold = 0.54480;
            return Predict_WFO_EURUSD_2026(features);
    }
}
