double XGBoost_Predict_WFO_v19_USDJPY(double &features[], int current_year, int current_month, double threshold) {
    if(current_year == 2017 && current_month >= 1 && current_month < 7) return predict_USDJPY_2017_1(features);
    if((current_year == 2017 && current_month >= 7) || (current_year == 2018 && current_month < 1)) return predict_USDJPY_2017_7(features);
    if(current_year == 2018 && current_month >= 1 && current_month < 7) return predict_USDJPY_2018_1(features);
    if((current_year == 2018 && current_month >= 7) || (current_year == 2019 && current_month < 1)) return predict_USDJPY_2018_7(features);
    if(current_year == 2019 && current_month >= 1 && current_month < 7) return predict_USDJPY_2019_1(features);
    if((current_year == 2019 && current_month >= 7) || (current_year == 2020 && current_month < 1)) return predict_USDJPY_2019_7(features);
    if(current_year == 2020 && current_month >= 1 && current_month < 7) return predict_USDJPY_2020_1(features);
    if((current_year == 2020 && current_month >= 7) || (current_year == 2021 && current_month < 1)) return predict_USDJPY_2020_7(features);
    if(current_year == 2021 && current_month >= 1 && current_month < 7) return predict_USDJPY_2021_1(features);
    if((current_year == 2021 && current_month >= 7) || (current_year == 2022 && current_month < 1)) return predict_USDJPY_2021_7(features);
    if(current_year == 2022 && current_month >= 1 && current_month < 7) return predict_USDJPY_2022_1(features);
    if((current_year == 2022 && current_month >= 7) || (current_year == 2023 && current_month < 1)) return predict_USDJPY_2022_7(features);
    if(current_year == 2023 && current_month >= 1 && current_month < 7) return predict_USDJPY_2023_1(features);
    if((current_year == 2023 && current_month >= 7) || (current_year == 2024 && current_month < 1)) return predict_USDJPY_2023_7(features);
    if(current_year == 2024 && current_month >= 1 && current_month < 7) return predict_USDJPY_2024_1(features);
    if((current_year == 2024 && current_month >= 7) || (current_year == 2025 && current_month < 1)) return predict_USDJPY_2024_7(features);
    if(current_year == 2025 && current_month >= 1 && current_month < 7) return predict_USDJPY_2025_1(features);
    if((current_year == 2025 && current_month >= 7) || (current_year == 2026 && current_month < 1)) return predict_USDJPY_2025_7(features);
    // Fallback para OOS puro / Live trading
    return predict_USDJPY_2025_7(features);
}
