double XGBoost_Predict_WFO_XAUUSD(const double &features[], int year, double &out_threshold) {
    if(year < 2016) year = 2016;
    if(year > 2026) year = 2026;

    switch(year) {
        case 2016:
            out_threshold = 0.59824;
            return Predict_WFO_XAUUSD_2016(features);
        case 2017:
            out_threshold = 0.59241;
            return Predict_WFO_XAUUSD_2017(features);
        case 2018:
            out_threshold = 0.56773;
            return Predict_WFO_XAUUSD_2018(features);
        case 2019:
            out_threshold = 0.56348;
            return Predict_WFO_XAUUSD_2019(features);
        case 2020:
            out_threshold = 0.57427;
            return Predict_WFO_XAUUSD_2020(features);
        case 2021:
            out_threshold = 0.58708;
            return Predict_WFO_XAUUSD_2021(features);
        case 2022:
            out_threshold = 0.56141;
            return Predict_WFO_XAUUSD_2022(features);
        case 2023:
            out_threshold = 0.55453;
            return Predict_WFO_XAUUSD_2023(features);
        case 2024:
            out_threshold = 0.55538;
            return Predict_WFO_XAUUSD_2024(features);
        case 2025:
            out_threshold = 0.55162;
            return Predict_WFO_XAUUSD_2025(features);
        case 2026:
            out_threshold = 0.55831;
            return Predict_WFO_XAUUSD_2026(features);
        default:
            out_threshold = 0.55831;
            return Predict_WFO_XAUUSD_2026(features);
    }
}
