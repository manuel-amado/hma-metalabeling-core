double XGBoost_Predict_WFO_AUDUSD(const double &features[], int year, double &out_threshold) {
    if(year < 2017) year = 2017;
    if(year > 2026) year = 2026;

    switch(year) {
        case 2017:
            out_threshold = 0.56134;
            return Predict_WFO_AUDUSD_2017(features);
        case 2018:
            out_threshold = 0.55423;
            return Predict_WFO_AUDUSD_2018(features);
        case 2019:
            out_threshold = 0.55911;
            return Predict_WFO_AUDUSD_2019(features);
        case 2020:
            out_threshold = 0.56109;
            return Predict_WFO_AUDUSD_2020(features);
        case 2021:
            out_threshold = 0.56597;
            return Predict_WFO_AUDUSD_2021(features);
        case 2022:
            out_threshold = 0.58162;
            return Predict_WFO_AUDUSD_2022(features);
        case 2023:
            out_threshold = 0.55533;
            return Predict_WFO_AUDUSD_2023(features);
        case 2024:
            out_threshold = 0.56365;
            return Predict_WFO_AUDUSD_2024(features);
        case 2025:
            out_threshold = 0.56605;
            return Predict_WFO_AUDUSD_2025(features);
        case 2026:
            out_threshold = 0.55174;
            return Predict_WFO_AUDUSD_2026(features);
        default:
            out_threshold = 0.55174;
            return Predict_WFO_AUDUSD_2026(features);
    }
}
