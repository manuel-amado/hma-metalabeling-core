                sum += -0.0177159309;
            } else {
                sum += 0.00388456858;
            }
        }
    }

    // --- Tree 81 ---
    if(f[6] < 0.0690911636) {
        if(f[6] < -0.0550000556) {
            if(f[5] < 0.608698308) {
                sum += 0.000388566259;
            } else {
                sum += -0.00333542144;
            }
        } else {
            if(f[10] < 0.265231371) {
                sum += -0.00257186731;
            } else {
                sum += -0.0111881495;
            }
        }
    } else {
        if(f[5] < -0.263860136) {
            if(f[10] < -0.621325672) {
                sum += 0.00314239785;
            } else {
                sum += -0.00483439583;
            }
        } else {
            if(f[17] < 1.0) {
                sum += 0.0051152301;
            } else {
                sum += 0.00128655497;
            }
        }
    }

    // --- Tree 82 ---
    if(f[4] < -0.0909090936) {
        if(f[8] < 0.387387872) {
            if(f[6] < 0.626479864) {
                sum += -0.000824802031;
            } else {
                sum += 0.00399357919;
            }
        } else {
            if(f[9] < -0.441470861) {
                sum += -0.00125485926;
            } else {
                sum += 0.00772638572;
            }
        }
    } else {
        if(f[4] < 0.181818187) {
            if(f[2] < -0.574472308) {
                sum += -0.0152470209;
            } else {
                sum += -0.00236844691;
            }
        } else {
            if(f[8] < -0.144773334) {
                sum += 0.00234989589;
            } else {
                sum += -0.00128699897;
            }
        }
    }

    // --- Tree 83 ---
    if(f[3] < 0.948945343) {
        if(f[2] < 0.576586723) {
            if(f[2] < 0.515105903) {
                sum += -0.00106069166;
            } else {
                sum += -0.00958446413;
            }
        } else {
            if(f[4] < -0.0909090936) {
                sum += 0.00445981324;
            } else {
                sum += -0.000509870239;
            }
        }
    } else {
        if(f[13] < -0.402167171) {
            if(f[12] < 0.300000012) {
                sum += -0.012995312;
            } else {
                sum += 0.00311872317;
            }
        } else {
            if(f[2] < 0.00462315883) {
                sum += 0.00738516077;
            } else {
                sum += 1.75557834e-05;
            }
        }
    }

    // 3. Transformacion Sigmoidal Logistica
    double prob = 1.0 / (1.0 + MathExp(-sum));
    return prob;
}