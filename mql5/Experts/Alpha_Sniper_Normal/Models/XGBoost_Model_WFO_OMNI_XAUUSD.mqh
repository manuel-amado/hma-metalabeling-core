double XGBoost_Predict_WFO_OMNI_XAUUSD(double &features[], int current_year, int current_month) {
    if(current_year == 2018) return predict_OMNI_XAUUSD_2018_1(features);
    if(current_year == 2019) return predict_OMNI_XAUUSD_2019_1(features);
    if(current_year == 2020) return predict_OMNI_XAUUSD_2020_1(features);
    if(current_year == 2021) return predict_OMNI_XAUUSD_2021_1(features);
    if(current_year == 2022) return predict_OMNI_XAUUSD_2022_1(features);
    if(current_year == 2023) return predict_OMNI_XAUUSD_2023_1(features);
    if(current_year == 2024) return predict_OMNI_XAUUSD_2024_1(features);
    if(current_year == 2025) return predict_OMNI_XAUUSD_2025_1(features);
    if(current_year == 2026) return predict_OMNI_XAUUSD_2026_1(features);
    return predict_OMNI_XAUUSD_2026_1(features); // Fallback
}
