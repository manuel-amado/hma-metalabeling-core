                if(scaled[9] < -1.05995262) {
                    sum += -0.0292166229;
                } else {
                    sum += 0.00217489572;
                }
            } else {
                if(scaled[8] < 0.771608889) {
                    sum += -0.0361326821;
                } else {
                    sum += 0.000253541803;
                }
            }
        } else {
            if(scaled[5] < 0.120191507) {
                if(scaled[3] < -0.379882634) {
                    sum += -0.00312408083;
                } else {
                    sum += 0.0267441701;
                }
            } else {
                if(scaled[5] < 0.188134894) {
                    sum += -0.0414275303;
                } else {
                    sum += -0.000216185072;
                }
            }
        }
    }
    return 1.0 / (1.0 + MathExp(-(sum + (0.03546703739632838))));
}

double XGBoost_Predict_WFO_v20_XAUUSD(double &features[], int current_year, int current_month) {
    if(current_year == 2024 && current_month >= 1 && current_month < 7) return predict_V20_XAUUSD_2024_1(features);
    if((current_year == 2024 && current_month >= 7) || (current_year == 2025 && current_month < 1)) return predict_V20_XAUUSD_2024_7(features);
    // Fallback para OOS puro / Live trading
    return predict_V20_XAUUSD_2024_7(features);
}
