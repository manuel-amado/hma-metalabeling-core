double XGBoost_Predict_WFO_OMNI_V2_XAUUSD(double &features[], int current_year, int current_month) {
    if(current_year == 2018) return predict_OMNI_V2_XAUUSD_2018(features);
    if(current_year == 2019) return predict_OMNI_V2_XAUUSD_2019(features);
    if(current_year == 2020) return predict_OMNI_V2_XAUUSD_2020(features);
    if(current_year == 2021) return predict_OMNI_V2_XAUUSD_2021(features);
    if(current_year == 2022) return predict_OMNI_V2_XAUUSD_2022(features);
    if(current_year == 2023) return predict_OMNI_V2_XAUUSD_2023(features);
    if(current_year == 2024) return predict_OMNI_V2_XAUUSD_2024(features);
    if(current_year == 2025) return predict_OMNI_V2_XAUUSD_2025(features);
    if(current_year == 2026) return predict_OMNI_V2_XAUUSD_2026(features);
    return predict_OMNI_V2_XAUUSD_2026(features); // Fallback
}
